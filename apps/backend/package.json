{
  "name": "@jarvis/backend",
  "version": "0.1.0",
  "private": true,
  "description": "JARVIS backend: Express API + JARVIS WebSocket server (Milestone 11 real-time core)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src"
  },
  "dependencies": {
    "@jarvis/shared": "0.1.0",
    "@supabase/supabase-js": "^2.112.3",
    "drizzle-orm": "^0.45.2",
    "express": "^5.1.0",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0",
    "postgres": "^3.4.9",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.6",
    "typescript": "~6.0.2",
    "vitest": "^4.1.10"
  }
}
